# Copy to .env and fill in. Never commit .env.
FLASK_APP=app.py
FLASK_ENV=development
# Generate each with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

POSTGRES_USER=campus_chommie
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campus_chommie_dev
POSTGRES_TEST_DB=campus_chommie_test

# Token lifetimes: short access token, rotating refresh token.
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Email. "smtp" sends for real through any SMTP relay (the default).
# "fake" is for the automated tests only: it sends nothing, and codes are
# never written to any log. Delivery behaviour (timeout, retries,
# background sending) is in code: src/config.py. Only WHERE and AS WHOM we
# send belongs here.
MAIL_PROVIDER=smtp

# Mail server (example: a Gmail account with an app password)
#   MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  MAIL_USE_TLS=true
#   MAIL_USERNAME=you@gmail.com  MAIL_PASSWORD=<16-char app password>
#   MAIL_DEFAULT_SENDER=Campus Chommie <you@gmail.com>   (Gmail only sends as the signed-in address)
#   MAIL_REPLY_TO=you@gmail.com                  (an inbox someone reads; never a no-reply)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Campus Chommie <no-reply@example.com>
MAIL_REPLY_TO=

# Continue with Google: OAuth client IDs (Android + web), comma-separated.
# Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=

# Public address of this backend, for every link a person taps (the password
# reset email). It must be https and a real name, not an IP: phones upgrade
# the link to https, which the local http server can't answer.
# Development: an https tunnel to port 5000, e.g. your free static ngrok domain
#   ngrok http 5000 --url=https://<your-domain>.ngrok-free.dev
# Restart the backend after changing it. Production: the backend's https
# address (required).
APP_BASE_URL=http://localhost:5000

# The client's IP (shared/net/client_ip.py). true ONLY when the backend is
# reached through Cloudflare alone (a cloudflared tunnel): then rate limits,
# sessions and the audit trail use Cloudflare's CF-Connecting-IP.
BEHIND_CLOUDFLARE=false
